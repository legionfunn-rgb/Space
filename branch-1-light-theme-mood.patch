+/* =========================================================
+   Светлая тема (альтернативное оформление)
+   Подключено в index.html после modals.css.
+   Не совмещать с css/theme-retro.css: обе меняют тему.
+   ========================================================= */
+
+
+:root {
+  --bg: #f5f4ff;
+  --bg-2: #ffffff;
+  --surface: rgba(30, 27, 75, 0.04);
+  --surface-strong: rgba(30, 27, 75, 0.08);
+  --border: rgba(30, 27, 75, 0.10);
+  --border-strong: rgba(30, 27, 75, 0.20);
+  --text: #1e1b4b;
+  --muted: #5b5f85;
+  --star: #f59e0b;
+  --success: #059669;
+  --danger: #dc2626;
+  --glow: 0 0 22px rgba(139, 92, 246, 0.28), 0 0 40px rgba(236, 72, 153, 0.14);
+  --shadow-1: 0 1px 2px rgba(30, 27, 75, .06), 0 4px 8px rgba(30, 27, 75, .06);
+  --shadow-2: 0 2px 4px rgba(30, 27, 75, .06), 0 8px 16px rgba(30, 27, 75, .08), 0 20px 40px rgba(30, 27, 75, .08);
+  --shadow-3: 0 4px 8px rgba(30, 27, 75, .08), 0 16px 32px rgba(30, 27, 75, .10), 0 36px 72px rgba(30, 27, 75, .14);
+}
+
+body {
+  background-color: var(--bg);
+  background-image:
+    radial-gradient(900px 600px at 10% -10%, rgba(139, 92, 246, 0.12), transparent 60%),
+    radial-gradient(800px 600px at 110% 20%, rgba(236, 72, 153, 0.08), transparent 60%);
+}
+
+/* Шапка и меню */
+.site-header.is-scrolled { background: rgba(245, 244, 255, 0.85); box-shadow: 0 10px 30px rgba(30, 27, 75, .08); }
