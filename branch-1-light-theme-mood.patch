+.save-tag { color: var(--success); background: rgba(5, 150, 105, .12); }
+.plan li svg { stroke: var(--success); }
+
+/* Карточки и блоки */
+.glass { background: linear-gradient(180deg, #ffffff, #f7f6ff); }
+.plan.is-featured { background: linear-gradient(180deg, rgba(139, 92, 246, .10), rgba(236, 72, 153, .03) 60%, #fff); }
+.cta {
+  background:
+    radial-gradient(600px 300px at 0% 0%, rgba(139, 92, 246, .22), transparent 70%),
+    radial-gradient(600px 300px at 100% 100%, rgba(236, 72, 153, .2), transparent 70%),
+    #ffffff;
+}
+.cta p { color: var(--muted); }
+.site-footer { background: linear-gradient(180deg, transparent, rgba(30, 27, 75, .04)); }
+
+/* Окна и уведомления */
+.modal-backdrop { background: rgba(30, 27, 75, 0.35); }
+.modal-panel, .account-menu, .toast { background: #ffffff; }
+
+/* Поля ввода и элементы форм */
+input[type="text"], input[type="email"], input[type="password"], input[type="search"] { background: #ffffff; }
+select { background-color: #ffffff; }
+select option { background: #ffffff; color: var(--text); }
+.checkbox input[type="checkbox"] { background: #ffffff; }
+.pw-meter { background: rgba(30, 27, 75, .10); }
+input[type="range"] {
+  background: linear-gradient(90deg, var(--accent-1), var(--accent-2)) 0 / var(--fill, 0%) 100% no-repeat,
